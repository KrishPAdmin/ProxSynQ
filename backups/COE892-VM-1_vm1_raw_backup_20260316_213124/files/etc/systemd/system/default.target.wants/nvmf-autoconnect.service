[Unit]
Description=Connect NVMe-oF subsystems automatically during boot
ConditionPathExists=|/etc/nvme/config.json
ConditionPathExists=|/etc/nvme/discovery.conf
Wants=modprobe@nvme_fabrics.service
After=modprobe@nvme_fabrics.service
After=network-online.target
Before=remote-fs-pre.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nvme connect-all --context=autoconnect

[Install]
WantedBy=default.target
